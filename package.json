{
  "name": "kenshi-mod-manager",
  "version": "1.1.0",
  "private": true,
  "description": "Kenshi mod lists, load order, and patch sorting for Windows and Linux",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/build-info.mjs && vite --host 127.0.0.1",
    "build": "node scripts/build-info.mjs && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs && node tests/record-ui.mjs",
    "package": "electron-builder --publish never",
    "test:packaged": "node tests/packaged.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.9",
    "vite": "^8.3.1"
  },
  "license": "MIT",
  "author": "Ouroborosrex",
  "homepage": "https://github.com/Ouroborosrex/kenshi-mod-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ouroborosrex/kenshi-mod-manager.git"
  },
  "build": {
    "appId": "io.github.ouroborosrex.kenshimodmanager",
    "productName": "Kenshi Mod Manager",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "assets/icon.png",
      "LICENSE",
      "package.json"
    ],
    "artifactName": "Kenshi-Mod-Manager-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "assets/icon.png",
      "executableName": "kenshi-mod-manager"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Kenshi-Mod-Manager-${version}-windows-${arch}-setup.${ext}"
    }
  }
}
